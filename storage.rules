rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isPlatformAdmin() {
      return isSignedIn()
        && ('platformAdmin' in request.auth.token)
        && request.auth.token.platformAdmin == true;
    }

    function isTenantOwner(tenantId) {
      return isPlatformAdmin()
        || (
          isSignedIn()
          && ('tenants' in request.auth.token)
          && (request.auth.token.tenants is map)
          && (tenantId in request.auth.token.tenants)
          && request.auth.token.tenants[tenantId] == 'owner'
        );
    }

    function isAllowedImageFolder(folder) {
      return folder in ['logo', 'profile', 'hero', 'portfolio'];
    }

    function isAllowedImageContentType(folder) {
      return folder == 'logo'
        ? request.resource.contentType.matches('image/(jpeg|jpg|png|webp|svg\\+xml)')
        : request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
    }

    match /tenants/{tenantId}/{folder}/{fileName} {
      allow read: if isAllowedImageFolder(folder);
      allow create, update: if isAllowedImageFolder(folder)
        && isTenantOwner(tenantId)
        && request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType != null
        && isAllowedImageContentType(folder);
      allow delete: if isAllowedImageFolder(folder)
        && isTenantOwner(tenantId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
