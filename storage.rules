rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /logo/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|jpg|png|webp|svg\\+xml)');
      allow delete: if request.auth != null;
    }

    match /profile/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
      allow delete: if request.auth != null;
    }

    match /hero/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
      allow delete: if request.auth != null;
    }

    match /portfolio/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
      allow delete: if request.auth != null;
    }
  }
}
