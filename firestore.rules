rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read allows viewing availability; client writes are blocked so all bookings must pass through Cloud Functions
    match /slots/{slotId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /ownerinfo/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /portfolio/{workId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /prices/{priceId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
