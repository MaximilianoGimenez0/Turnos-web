rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reglas para la colección 'slots'
    match /slots/{slotId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Reglas para la información del dueño / perfil del negocio
    match /ownerinfo/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Reglas para la galería de trabajos previos (portfolio)
    match /portfolio/{workId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Reglas para los servicios de turnos (/services)
    match /services/{serviceId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Reglas para el catálogo de precios y extras
    match /prices/{priceId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
