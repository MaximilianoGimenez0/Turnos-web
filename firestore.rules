rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Full slot documents contain client PII (name, email, phone, notes) and lock tokens -> admin only.
    match /slots/{slotId} {
      allow read, write: if request.auth != null;
    }

    // Consolidated public availability document synced exclusively by Cloud Functions (1 read per visit).
    match /public_meta/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Sanitized public availability and busy-interval projection synced exclusively by Cloud Functions.
    match /public_slots/{slotId} {
      allow read: if true;
      allow write: if false;
    }

    match /ownerinfo/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /portfolio/{workId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /prices/{priceId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Internal backend collections managed solely via Firebase Admin SDK.
    match /payment_attempts/{attemptId} {
      allow read, write: if false;
    }

    match /payment_incidents/{incidentId} {
      allow read, write: if false;
    }

    // Explicit default deny for any other collection.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
