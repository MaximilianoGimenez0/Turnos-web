MP_ACCESS_TOKEN=TEST-1234567890123456-123456-abcdef1234567890abcdef1234567890-123456789

# Secreto de firma de Webhooks de Mercado Pago (panel Developers -> Webhooks -> Clave secreta)
# En producción, cuando está configurado, valida el header x-signature (HMAC-SHA256).
MP_WEBHOOK_SECRET=

# URL base del Frontend (usado para redirecciones de retorno de pago Checkout Pro)
CLIENT_APP_URL=http://localhost:5173

# URL pública del webhook desplegado en Cloud Functions
MP_WEBHOOK_URL=https://us-central1-tu-proyecto-id.cloudfunctions.net/mpWebhook

# Nombre, correo y teléfono de WhatsApp del negocio
# Para nombre y correo se priorizan los datos de ownerinfo/profile en Firestore.
# Para BUSINESS_PHONE (formato internacional sin +, ej: 5491112345678): si se define aquí,
# se utiliza en el botón de WhatsApp de los correos; si se deja vacío, toma el de Firestore.
BUSINESS_NAME=Turnos Web
BUSINESS_EMAIL=dueno@ejemplo.com
BUSINESS_PHONE=

# Obtén tu API Key en: https://resend.com/api-keys
RESEND_API_KEY=re_12345678_abcdefghijklmnopqrstuv
# Remitente de los correos (onboarding@resend.dev para pruebas o dominio verificado en produccion)
RESEND_FROM_EMAIL=Turnos Web <onboarding@resend.dev>
