# Credenciales de Mercado Pago de RESPALDO exclusivamente para tenants con `isDemo: true`.
# Los negocios comerciales reales (`isDemo: false`) deben cargar sus propias credenciales
# desde el Panel Admin (almacenadas en /tenants/{tenantId}/private_config/integrations).
# Un negocio comercial sin credenciales propias rechazará el cobro online de forma controlada.
MP_ACCESS_TOKEN=TEST-1234567890123456-123456-abcdef1234567890abcdef1234567890-123456789

# Secreto de firma de Webhooks de Mercado Pago (panel Developers -> Webhooks -> Clave secreta)
# Actúa únicamente como respaldo para tenants con `isDemo: true` sin secreto propio.
MP_WEBHOOK_SECRET=

# URL base del Frontend (usado para redirecciones de retorno /:tenantSlug/payment/* y enlaces /:tenantSlug/admin)
CLIENT_APP_URL=http://localhost:5173

# URL pública base del webhook desplegado en Cloud Functions (se añade ?tenantId={tenantId} por negocio)
MP_WEBHOOK_URL=https://us-central1-tu-proyecto-id.cloudfunctions.net/mpWebhook

# Datos de respaldo utilizados únicamente por tenants con `isDemo: true` cuando faltan en /tenants/{tenantId}/ownerinfo/profile
# El correo del SuperAdmin para notificaciones de plataforma y fallback de /demo se configura
# únicamente mediante `npm run cli -- init --admin-email <correo>` (persistido en /platform_config/settings).
BUSINESS_NAME=Turneado
BUSINESS_PHONE=

# Amazon SES (envío de correos transaccionales con @aws-sdk/client-sesv2)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA_TU_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=tu_secret_access_key_aqui
SES_FROM_EMAIL=Turneado <noreply@turneado.app>
# Opcional: Configuration Set de SES para métricas/rebotes
SES_CONFIGURATION_SET=
