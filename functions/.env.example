# ==========================================
# CONFIGURACIÓN DE MERCADO PAGO (BACKEND / FUNCTIONS)
# ==========================================
MP_ACCESS_TOKEN=TEST-1234567890123456-123456-abcdef1234567890abcdef1234567890-123456789

# URL base del Frontend (usado para redirecciones de retorno de pago Checkout Pro)
CLIENT_APP_URL=http://localhost:5173

# URL pública del webhook desplegado en Cloud Functions
MP_WEBHOOK_URL=https://us-central1-tu-proyecto-id.cloudfunctions.net/mpWebhook

# Correo del dueño del servicio / administrador para recibir confirmaciones de reservas
BUSINESS_EMAIL=dueno@ejemplo.com

# ==========================================
# CONFIGURACIÓN DE RESEND (ENVÍO DE MAILS)
# ==========================================
# Obtén tu API Key en: https://resend.com/api-keys
RESEND_API_KEY=re_12345678_abcdefghijklmnopqrstuv
# Remitente de los correos: Para pruebas usar 'Turnos Web <onboarding@resend.dev>'. En producción usar tu dominio verificado.
RESEND_FROM_EMAIL=Turnos Web <onboarding@resend.dev>
